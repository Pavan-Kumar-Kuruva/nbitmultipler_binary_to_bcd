module multiplier_bcd_tb;

reg [3:0] A;
reg [3:0] B;

wire [7:0] product;

wire [3:0] hundreds;
wire [3:0] tens;
wire [3:0] ones;

multiplier_bcd_top uut (
    .A(A),
    .B(B),
    .product(product),
    .hundreds(hundreds),
    .tens(tens),
    .ones(ones)
);

initial begin

    // Test 1: 3 × 2 = 6
    A = 4'b0011;
    B = 4'b0010;
    #10;

    // Test 2: 5 × 3 = 15
    A = 4'b0101;
    B = 4'b0011;
    #10;

    // Test 3: 11 × 3 = 33
    A = 4'b1011;
    B = 4'b0011;
    #10;

    // Test 4: 15 × 15 = 225
    A = 4'b1111;
    B = 4'b1111;
    #10;

    $finish;

